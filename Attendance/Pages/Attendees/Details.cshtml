@page "{id:int}/{EventId:int}"
@model Attendance.Pages_Attendees.DetailsModel

@{
    ViewData["Title"] = "Details";
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Details</title>
</head>
<body>

<div>
    <h4>Attendee</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Attendee.EventId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Attendee.EventId)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Attendee.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Attendee.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Attendee.IsCheckedIn)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Attendee.IsCheckedIn)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Attendee.CheckInTime)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Attendee.CheckInTime)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Attendee.Id" asp-route-EventId="@Model.EventId" class="link">Edit</a> |
    <a asp-page="./Index" asp-route-EventId="@Model.EventId" class="link">Back to List</a>
</div>
</body>
</html>
