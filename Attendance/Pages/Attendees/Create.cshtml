@page "{EventId:int}"
@model Attendance.Pages_Attendees.CreateModel

        @{
        
        }
        
        <!DOCTYPE html>
        
        <html>
        <head>
        <meta name="viewport" content="width=device-width" />
        <title>Create</title>
        </head>
        <body>
        
    <h4>Attendee</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Attendee.EventId" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Attendee.Name" class="control-label"></label>
                <input asp-for="Attendee.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="Attendee.Name" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Attendee.IsCheckedIn" /> @Html.DisplayNameFor(model => model.Attendee.IsCheckedIn)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Attendee.CheckInTime" class="control-label"></label>
                <input asp-for="Attendee.CheckInTime" class="form-control" />
                <span asp-validation-for="Attendee.CheckInTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index" asp-route-EventId="@Model.EventId" class="link">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
</body>
</html>
