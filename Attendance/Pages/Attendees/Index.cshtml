@page "{EventId:int}"
@model Attendance.Pages_Attendees.IndexModel

@{
    
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
<p>
    <a class="link" asp-page="Create" asp-route-EventId="@Model.EventId">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Attendee[0].EventId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Attendee[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Attendee[0].IsCheckedIn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Attendee[0].CheckInTime)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Attendee) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.EventId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsCheckedIn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CheckInTime)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id" asp-route-EventId="@Model.EventId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id" asp-route-EventId="@Model.EventId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id" asp-route-EventId="@Model.EventId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</body>
</html>
